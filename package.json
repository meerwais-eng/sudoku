{
  "name": "sudoku-prime",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build && node -e \"const fs=require('fs');if(fs.existsSync('.next/standalone')){fs.cpSync('.next/static','.next/standalone/.next/static',{force:true});fs.cpSync('public','.next/standalone/public',{force:true})}\"",
    "build:pwa": "cross-env BUILD_TARGET=pwa next build",
    "build:android": "cross-env BUILD_TARGET=android next build && npx cap sync android",
    "build:pages": "cross-env NEXT_STATIC_EXPORT=true next build",
    "export:pages": "npm run build:pages && npx serve out",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "generate:android-icons": "node scripts/generate-android-icons.mjs",
    "generate:keystore": "node scripts/generate-keystore.js",
    "build:aab": "node -e \"const{execSync}=require('child_process');const cmd=process.platform==='win32'?'scripts\\\\build-aab.bat':'bash scripts/build-aab.sh';execSync(cmd,{stdio:'inherit',cwd:process.cwd()})\"",
    "build:apk": "node -e \"const{execSync}=require('child_process');const cmd=process.platform==='win32'?'scripts\\\\build-apk.bat':'bash scripts/build-apk.sh';execSync(cmd,{stdio:'inherit',cwd:process.cwd()})\"",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:copy": "npx cap copy android",
    "lint": "eslint .",
    "preview": "npx serve out"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/supabase-js": "^2.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
